{
  "name": "mtg-shorts",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline semi-autônomo: pesquisa combos de Magic, escreve roteiro, gera narração e renderiza shorts verticais com identidade visual fixa.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "pipeline": "tsx pipeline/run.ts",
    "pesquisar": "tsx pipeline/run.ts --dry-run",
    "produzir": "tsx pipeline/run.ts --aprovados",
    "roteiro": "tsx pipeline/roteiro.ts",
    "painel": "tsx pipeline/server.ts --open",
    "sfx": "tsx scripts/gerar-sfx.ts",
    "logo": "tsx scripts/gerar-logo.ts",
    "render:exemplo": "remotion render src/index.ts Short output/exemplo.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "dotenv": "^16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
