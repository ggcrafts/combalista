# Copie este arquivo para .env e preencha.

# --- Chaves ---
# Opcional. Com ela, `npm run pipeline` faz tudo sozinho. Sem ela, os roteiros
# são escritos pelo Claude Code: `npm run pesquisar` e depois /roteirizar.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=...
# ID da voz no ElevenLabs (Voices > ... > Copy voice ID). Escolha uma voz que soe bem em PT-BR.
ELEVENLABS_VOICE_ID=...

# --- Voz ---
# cartesia = voz neural (plano grátis) | elevenlabs = voz neural (pago) | windows = voz do Windows, grátis e offline | mudo = sem áudio
# (no painel dá para escolher a voz a cada produção)
TTS_PROVIDER=windows
# Voz e velocidade (-10 a 10) quando TTS_PROVIDER=windows
TTS_WINDOWS_VOICE=Microsoft Maria Desktop
TTS_WINDOWS_RATE=3
# Velocidade da voz neural: Cartesia 0.6 a 1.5, ElevenLabs até 1.2
TTS_VELOCIDADE=1.25

# Cartesia (voz): https://play.cartesia.ai
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# --- Modelos ---
CLAUDE_MODEL=claude-sonnet-5-5
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Canal ---
# Aparece no vídeo e no CTA
CANAL_NOME=CombaLista
HANDLE=@seucanal

# --- Pesquisa ---
# Pautas misturadas em cada pesquisa: novidade, inusitado, joia, barato
PAUTAS=novidade,inusitado,joia
# "Novidade" = carta que estreou nos últimos N meses
NOVIDADE_MESES=6
# "Joia escondida" = carta abaixo desta posição no ranking do EDHREC
JOIA_RANK_EDHREC=4000
# Teto de preço do combo nas pautas que não são "barato" (R$)
PRECO_TETO_BRL=600
# Quantos vídeos por execução
VIDEOS_PER_RUN=3
# Consulta no Commander Spellbook (mesma sintaxe da busca do site)
CSB_QUERY=legal:commander
# Combos com no máximo N cartas
MAX_CARDS=3
# Pauta "barato": só combos cujo custo total estimado fique abaixo disso (R$)
MAX_TOTAL_BRL=150
# Exige combos sem "requisitos genéricos" (ex.: "um outlet de sacrifício"). 1 = mais didático
ONLY_SELF_CONTAINED=1

# --- Preço ---
# Fallback do câmbio caso a API de cotação falhe
FX_USD_BRL_FALLBACK=5.50
# Multiplicador sobre o preço convertido (ajuste para aproximar o mercado BR). 1 = sem ajuste
PRICE_MULTIPLIER=1
